PORT=3000
# Postgres connection string (required) — the FULL form, not just the RDS
# endpoint: postgres://<user>:<password>@<host>:<port>/<database>. The
# database is created automatically on start if it does not exist yet (the
# server connects to DATABASE_BOOTSTRAP_DB, "postgres" by default, to do
# that), then tables are created/migrated in it.
#
# e.g. for an RDS endpoint "khaadsetu.cylskc8umprm.us-east-1.rds.amazonaws.com"
# with master user "postgres" and a database named "khaadsetu":
#   DATABASE_URL=postgres://postgres:<password>@khaadsetu.cylskc8umprm.us-east-1.rds.amazonaws.com:5432/khaadsetu
DATABASE_URL=postgres://postgres:password@localhost:5432/khaadsetu
# Set to true for managed Postgres that requires TLS (RDS, Supabase, ...) —
# RDS needs this.
DATABASE_SSL=true
# Only needed if this server's "postgres" maintenance database was renamed or
# removed (uncommon). Leave unset otherwise.
# DATABASE_BOOTSTRAP_DB=postgres
# If set, every /v1 request must send this in an X-API-Key header
API_KEY=
# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*
COMMISSION_RATE_PERCENT=5


# Time zone in which village centers' opening hours are judged.
CENTER_TIMEZONE=Asia/Kolkata

# Comma-separated emails of the platform administrators (super admins). They
# manage village centers and operators under /v1/admin. Nobody is one by default.
SUPER_ADMIN_EMAILS=

# Supabase project URL. When set, every /v1 request must send a valid Supabase
# access token (Authorization: Bearer ...) and data is owned by the token's user id.
# Leave empty for local development without login (falls back to X-Device-Id).
SUPABASE_URL=https://hoidcnxxlppaxfvlshbs.supabase.co

# Razorpay online payments. Get the keys from the Razorpay dashboard (test keys start with
# rzp_test_). Set them ONLY here, on the server: the secret must never be put in the app or in git.
# The webhook secret is optional: it lets Razorpay confirm a payment even if the app closed early
# (set the same value in the dashboard, with the URL https://<your-server>/webhooks/razorpay and the
# payment.captured and order.paid events). Leave the key id empty to switch online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The farming assistant (Google Gemini). Create a key in Google AI Studio and set it ONLY here, on the
# server: it must never be put in the app or in git. Leave empty to switch the assistant off.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Questions one farmer may ask the assistant per hour (default 40).
# ASSISTANT_PER_HOUR=40

# Requests allowed per minute from one client address (default 300). Raise it if many
# farmers share one connection.
# RATE_LIMIT_PER_MINUTE=300

# Home delivery (all optional; the values shown are the defaults).
# Fee = base + per km by road + per 10 kg above the first 10, rounded up to Rs 5, never below the minimum.
# DELIVERY_BASE_FEE=25
# DELIVERY_PER_KM=4
# DELIVERY_PER_10KG=2
# DELIVERY_MIN_FEE=30
# Farthest a delivery goes, by road, from the center to the farm.
# DELIVERY_MAX_KM=20
# Offers go to this many nearby partners at a time, each open this many minutes.
# DELIVERY_OFFERS_PER_ROUND=3
# DELIVERY_OFFER_MINUTES=4
# After this many minutes with nobody, the order goes back to plain pickup.
# DELIVERY_SEARCH_MINUTES=45
# Orders one partner may carry on one trip (the loads must also fit his vehicle together),
# and how close two drops must be to count as the same trip.
# DELIVERY_MAX_ACTIVE_JOBS=3
# DELIVERY_BATCH_KM=4
# A partner's posted trip serves jobs whose pickup and drop are each this close to its ends.
# DELIVERY_TRIP_MATCH_KM=8
# Farmer-to-farmer requests one person may have running at once.
# DELIVERY_MAX_OPEN_P2P=5
# Wrong-code guesses allowed per 15 minutes from one address on the code endpoints.
# RATE_LIMIT_OTP=10
