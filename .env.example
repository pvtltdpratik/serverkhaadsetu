PORT=3000
# Postgres connection string (required) — the FULL form, not just the RDS
# endpoint: postgres://<user>:<password>@<host>:<port>/<database>. The
# database is created automatically on start if it does not exist yet (the
# server connects to DATABASE_BOOTSTRAP_DB, "postgres" by default, to do
# that), then tables are created/migrated in it.
#
# e.g. for an RDS endpoint "khaadsetu.cylskc8umprm.us-east-1.rds.amazonaws.com"
# with master user "postgres" and a database named "khaadsetu":
#   DATABASE_URL=postgres://postgres:<password>@khaadsetu.cylskc8umprm.us-east-1.rds.amazonaws.com:5432/khaadsetu
DATABASE_URL=postgres://postgres:password@localhost:5432/khaadsetu
# Set to true for managed Postgres that requires TLS (RDS, Supabase, ...) —
# RDS needs this.
DATABASE_SSL=true
# Only needed if this server's "postgres" maintenance database was renamed or
# removed (uncommon). Leave unset otherwise.
# DATABASE_BOOTSTRAP_DB=postgres
# If set, every /v1 request must send this in an X-API-Key header
API_KEY=
# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*
COMMISSION_RATE_PERCENT=5


# Time zone in which village centers' opening hours are judged.
CENTER_TIMEZONE=Asia/Kolkata

# Comma-separated emails of the platform administrators (super admins). They
# manage village centers and operators under /v1/admin. Nobody is one by default.
SUPER_ADMIN_EMAILS=

# Supabase project URL. When set, every /v1 request must send a valid Supabase
# access token (Authorization: Bearer ...) and data is owned by the token's user id.
# Leave empty for local development without login (falls back to X-Device-Id).
SUPABASE_URL=https://hoidcnxxlppaxfvlshbs.supabase.co

# Requests allowed per minute from one client address (default 300). Raise it if many
# farmers share one connection.
# RATE_LIMIT_PER_MINUTE=300
